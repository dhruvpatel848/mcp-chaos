# Copy to .env and fill in (.env is gitignored). Only needed for the real-LLM example agent (examples/llm_agent).
# Run:  mcp-chaos attack --target "python examples/llm_agent/agent.py --provider <name>" \
#         --env-file .env --pass-env <NAME>_API_KEY --pass-env <NAME>_MODEL
# MODEL values must be API model IDs from the vendor's CURRENT docs (e.g. lower-case ids, not display names like 'Gemini 2.5 Flash-Lite';
# retired models return 404). Verified live: GEMINI_MODEL=gemini-3.5-flash-lite Optional <NAME>_BASE_URL overrides.
# Real runs spend credits. Start with: --mode data-exfil --runs 1

# --- Global ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
TOGETHER_API_KEY=
TOGETHER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- China ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DASHSCOPE_API_KEY=          # Alibaba Qwen (provider name: qwen)
DASHSCOPE_MODEL=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # international endpoint
MOONSHOT_API_KEY=           # Kimi
MOONSHOT_MODEL=
ZHIPU_API_KEY=              # GLM
ZHIPU_MODEL=
QIANFAN_API_KEY=            # Baidu ERNIE (provider name: baidu)
QIANFAN_MODEL=
MINIMAX_API_KEY=
MINIMAX_MODEL=
YI_API_KEY=                 # 01.AI
YI_MODEL=

# --- Any OpenAI-compatible server (local vLLM / Ollama / gateway) ---
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
